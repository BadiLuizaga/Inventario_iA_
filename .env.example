# Referencia de variables del proyecto. La app web NO lee este archivo
# (no hay paso de compilación): los valores públicos del cliente van en
# js/config.js (copia de js/config.example.js).
#
# Úsalo para herramientas de servidor/CLI (p. ej. `supabase` CLI) y
# guarda tu copia como `.env`, que está en .gitignore.

# Públicos (pueden ir al navegador, protegidos por RLS)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# PRIVADOS — solo para scripts de servidor o CLI. NUNCA en js/ ni en el navegador.
# SUPABASE_SECRET_KEY=
# SUPABASE_DB_PASSWORD=
