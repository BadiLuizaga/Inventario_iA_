# Copia este archivo como `.env` (está en .gitignore) para Docker Compose
# y para herramientas de servidor/CLI.
#
# Desarrollo sin Docker: los valores públicos van en js/config.js
# (copia de js/config.example.js).

# --- Públicos: pueden llegar al navegador (protegidos por RLS) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
TIENDA_NOMBRE=Tienda de calzado
MONEDA=Bs

# Puerto local de Docker (8080 suele estar ocupado por otros proyectos)
APP_PORT=8088

# --- PRIVADOS: solo para scripts de servidor o CLI. NUNCA en js/ ni en el navegador ---
# SUPABASE_SECRET_KEY=
# SUPABASE_DB_PASSWORD=
